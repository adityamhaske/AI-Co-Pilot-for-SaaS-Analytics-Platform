# Copy to .env and fill in real values:  cp .env.example .env
#
# The app validates this file at import and refuses to boot on a missing or weak
# secret, so placeholders below must be replaced before `uvicorn` will start.

# development | test | production
# `test` relaxes the secret requirements so the suite runs without a real key.
ENVIRONMENT=development

# Required in production. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required. Minimum 32 characters. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=

# SQLite is fine locally; production must use PostgreSQL (the app rejects
# sqlite:// when ENVIRONMENT=production).
DATABASE_URL=sqlite:///./test.db

# JSON array — this is a List[str], so a bare "http://..." string will not parse.
# Must match the port the frontend actually serves on (vite.config.ts -> 6002).
CORS_ORIGINS=["http://localhost:6002"]
