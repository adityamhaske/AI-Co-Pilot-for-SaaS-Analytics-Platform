# Copy to .env and fill in real values:  cp .env.example .env
#
# The app validates this file at import and refuses to boot on a missing or weak
# secret, so placeholders below must be replaced before `uvicorn` will start.

# development | test | production
# `test` relaxes the secret requirements so the suite runs without a real key.
ENVIRONMENT=development

# Which model answers questions: anthropic | openai | gemini
# Only the selected provider's SDK and key are needed; the others can be absent.
LLM_PROVIDER=anthropic

# Blank uses the provider's default (claude-sonnet-4-6 / gpt-4.1 / gemini-2.5-pro).
LLM_MODEL=

# Set the key for the provider you chose above. Required in production.
#   anthropic  https://console.anthropic.com/
#   openai     https://platform.openai.com/api-keys
#   gemini     https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Required. Minimum 32 characters. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=

# SQLite is fine locally; production must use PostgreSQL (the app rejects
# sqlite:// when ENVIRONMENT=production).
DATABASE_URL=sqlite:///./test.db

# JSON array — this is a List[str], so a bare "http://..." string will not parse.
# Must match the port the frontend actually serves on (vite.config.ts -> 6002).
CORS_ORIGINS=["http://localhost:6002"]
